{
  "name": "classping",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @classping/web",
    "dev:api": "PORT=3001 npm run start:dev --workspace @classping/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down",
    "dev:mobile": "npm run start --workspace @classping/mobile",
    "mobile:android": "npm run android --workspace @classping/mobile",
    "mobile:ios": "npm run ios --workspace @classping/mobile",
    "typecheck:mobile": "npm run typecheck --workspace @classping/mobile",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:seed:rooms": "npm run seed:rooms --workspace @classping/api",
    "dev:face": "cd services/face && uv run uvicorn app.main:build_app --factory --env-file .env --host 127.0.0.1 --port 8001",
    "test:face": "cd services/face && uv run pytest",
    "test:face:model": "cd services/face && uv run pytest -m model"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "supabase": "^2.121.0"
  }
}
