# รหัสลับที่ API ใช้เรียก face service (สุ่มยาวอย่างน้อย 32 ตัว)
# ต้องเป็นค่าเดียวกับ FACE_SERVICE_TOKEN ใน apps/api/.env
# สร้างได้ด้วย: openssl rand -hex 32
FACE_SERVICE_TOKEN=

# ชุดโมเดลของ InsightFace (โหลดเก็บที่ ~/.insightface ไม่อยู่ใน repo)
# โมเดลใช้ได้เพื่อการศึกษา/วิจัยเท่านั้น
FACE_MODEL=buffalo_l
# ขนาดภาพที่ตัวหาหน้าใช้ (พิกเซล) ยิ่งใหญ่ยิ่งเจอหน้าเล็กแต่ช้าลง
FACE_DET_SIZE=640
# cpu หรือ coreml (บน Mac M5 ลองแล้วเร็วพอกัน ใช้ cpu)
FACE_PROVIDER=cpu

# เกณฑ์รูปลงทะเบียนหน้า
# ด้านสั้นของกรอบหน้าต้องไม่ต่ำกว่ากี่พิกเซล
ENROLL_MIN_FACE_PX=112
# ความมั่นใจว่าเป็นหน้าคนขั้นต่ำ (0-1)
ENROLL_MIN_DET_SCORE=0.6
# ความคมชัดขั้นต่ำ ต่ำกว่านี้ถือว่าเบลอ
ENROLL_MIN_SHARPNESS=40

# เฟรมกล้อง: หน้าที่เล็กกว่านี้ (พิกเซล) ไม่เอาไปเทียบ
DETECT_MIN_FACE_PX=40

# ขนาดรูปสูงสุดที่รับ (ไบต์) ค่าเริ่มต้น 5 MB
MAX_IMAGE_BYTES=5242880

# ขนาด JSON สูงสุดที่รับ (ไบต์) ใช้กับ /faces/match ค่าเริ่มต้น 8 MB
MAX_JSON_BYTES=8388608
