# คัดลอกเป็น board.env (ที่ /home/student/workspace/classping-camera/board.env) แล้วกรอก ห้าม commit ไฟล์จริง
# install.sh คัดลอกให้เองถ้ายังไม่มี และตั้งสิทธิ์ให้อ่านได้เฉพาะ student

# ที่อยู่ API ต้องเป็น https:// (ส่ง token กับภาพหน้าไปด้วย) ถ้าเป็น http:// ที่ไม่ใช่เครื่องตัวเอง โปรแกรมไม่เริ่ม
API_URL=https://api.example.com
# เฉพาะตอนพัฒนา (Mac ผ่านฮอตสปอตไม่มี TLS) ตั้งเป็น 1 เพื่อยอมใช้ http:// ห้ามใช้จริง
# ALLOW_PLAIN_HTTP=1
# token กล้องหน้าห้อง ได้จาก npm run db:seed:camera
CAMERA_TOKEN=
# สตรีมของกล้อง CCTV มีรหัสผ่านอยู่ใน URL ได้ เช่น (Tapo C540V) rtsp://user:pass@<camera-ip>:554/stream1
RTSP_URL=
# วิดีโอดูสด/อัดเก็บ: บอร์ดส่งไปที่อยู่ที่ API บอก (MEDIA_RTSP_URL ใน apps/api/.env) ไม่ได้ตั้งที่นี่
# ค่านั้นต้องเป็นที่อยู่ที่บอร์ดต่อถึง เช่น rtsp://<IP ของเครื่อง API ใน LAN>:8554 ไม่ใช่ 127.0.0.1
# ขาวิดีโอเป็น RTSP ธรรมดาใน LAN ไม่เข้ารหัส
# โฟลเดอร์ไฟล์ .rknn (ค่าเริ่มต้น ~/workspace/classping-models)
MODEL_DIR=/home/student/workspace/classping-models
# ชื่อโมเดลหน้า ต้องตรงกับที่ API ใช้
FACE_MODEL=buffalo_l
# หน้าเล็กกว่านี้ (พิกเซลของภาพเต็ม) ไม่ส่ง
DETECT_MIN_FACE_PX=40
# หน้าเล็กกว่านี้ไม่ตรวจ liveness
LIVENESS_MIN_FACE_PX=40
