# ได้จาก npm run db:seed:camera (สคริปต์เขียนให้เอง) ห้าม commit
CAMERA_TOKEN=
API_URL=http://127.0.0.1:3001
# หมายเลขกล้องใน OpenCV (เครื่องที่มีหลายกล้อง ลำดับอาจไม่ตรงกับที่ระบบแสดง)
CAMERA_INDEX=0
# ย่อภาพก่อนส่งให้กว้างไม่เกินนี้ (พิกเซล)
FRAME_MAX_WIDTH=1280

# กล้องประตู (npm run dev:door)
# token ของกล้องประตู ได้จาก npm run db:seed:camera -- "<ห้อง>" --door
DOOR_CAMERA_TOKEN=
# หมายเลขกล้องประตูใน OpenCV (ต้องตั้ง ห้ามปล่อยว่าง ไม่งั้นอาจไปเปิดกล้องหน้าห้อง)
DOOR_CAMERA_INDEX=
# ที่ไฟล์โมเดล yolox_s.onnx (ไม่ commit ไฟล์โมเดล)
DOOR_MODEL_PATH=
# กรอบพื้นหน้าประตู 4 มุม x,y เป็นสัดส่วน 0..1 ของภาพ 2 จุดแรกคือขอบในห้อง 2 จุดหลังคือขอบฝั่งออก
DOOR_QUAD=
# ตั้งเป็น 1 เพื่อเปิดหน้าต่างดูสดตอนปรับกรอบ (ปกติปิด)
DOOR_PREVIEW=
