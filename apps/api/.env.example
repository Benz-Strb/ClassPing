PORT=3001
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# เมลแอดมินคนแรก คั่นด้วยคอมมา
ADMIN_EMAILS=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082
# Comma-separated IPs or CIDRs of trusted reverse proxies. Leave empty for direct connections.
TRUSTED_PROXY_ADDRESSES=
# face service (services/face) ต้องใช้ token ค่าเดียวกันทั้งสองฝั่ง
# สร้างได้ด้วย: openssl rand -hex 32
FACE_SERVICE_URL=http://127.0.0.1:8001
LEAVE_OCR_SERVICE_URL=http://127.0.0.1:8002
# Must match services/ocr/.env; independent from face scanning.
LEAVE_OCR_SERVICE_TOKEN=
FACE_SERVICE_TOKEN=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# เกณฑ์คะแนนเทียบหน้า (0 ถึง 1) ค่าเริ่มต้น 0.5 / 0.36
MATCH_ACCEPT_MIN=
MATCH_REVIEW_MIN=
# ให้กล้องเริ่มก่อนเวลาคาบกี่นาที ค่าเริ่มต้น 20
CAMERA_OPEN_BEFORE_MIN=
# คะแนน liveness ต่ำกว่านี้ถือว่าเป็นรูป/จอ (มากกว่า 0 น้อยกว่า 1) ว่าง = ปิด
LIVENESS_MIN=
# ต้องเจอคนจริงติดกันกี่ภาพถึงล้างสถานะสงสัย ค่าเริ่มต้น 3
LIVENESS_STREAK=
# โมเดลใบหน้าที่บอร์ดหน้าห้องใช้ ต้องตรงกับที่ลงทะเบียนไว้ ค่าเริ่มต้น buffalo_l
BOARD_FACE_MODEL=
# คะแนนขั้นต่ำที่บอร์ดใช้ยืนยันหน้า (0 ถึง 1) ค่าเริ่มต้น 0.9
BOARD_VERIFY_MIN=
# 1 = log คะแนนทุกหน้าที่กล้องจับได้ (ไม่มีรูป)
MATCH_LOG=
# media server (MediaMTX: npm run media:up) ไม่ตั้ง secret = ยังไม่เปิดกล้องสด/ดูย้อนหลัง
# สร้างได้ด้วย: openssl rand -hex 32 (คนละค่ากัน)
# TOKEN = เซ็น token ให้คนดู, SERVER = API ใช้เรียก playback/control API ของ MediaMTX
MEDIA_TOKEN_SECRET=
MEDIA_SERVER_SECRET=
# ค่าเริ่มต้นเป็นเครื่องตัวเอง ดูจากเครื่องอื่นในวงเดียวกันให้ใช้ชื่อเครื่อง เช่น http://BMac.local:8889
# MEDIA_RTSP_URL = ที่กล้องส่งวิดีโอเข้า (ค่าเริ่มต้น rtsp://127.0.0.1:8554 ใช้ได้แค่กล้องในเครื่องเดียวกับ API)
# มีบอร์ดหรือกล้องเครื่องอื่นต้องเป็นที่อยู่ที่ทุกเครื่องกล้องต่อถึง เช่น rtsp://<IP ของเครื่อง API ใน LAN>:8554
# ขานี้เป็น RTSP ธรรมดาใน LAN ไม่เข้ารหัส
MEDIA_RTSP_URL=
MEDIA_WEBRTC_URL=
MEDIA_PLAYBACK_URL=
MEDIA_API_URL=

# Optional local curriculum OCR text logs
CURRICULUM_OCR_LOG_DIR=
