PORT=3001
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# เมลแอดมินคนแรก คั่นด้วยคอมมา
ADMIN_EMAILS=
ALLOWED_ORIGINS=http://localhost:3000
# face service (services/face) ต้องใช้ token ค่าเดียวกันทั้งสองฝั่ง
# สร้างได้ด้วย: openssl rand -hex 32
FACE_SERVICE_URL=http://127.0.0.1:8001
FACE_SERVICE_TOKEN=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# เกณฑ์คะแนนเทียบหน้า (0 ถึง 1) ค่าเริ่มต้น 0.5 / 0.36
MATCH_ACCEPT_MIN=
MATCH_REVIEW_MIN=
# ให้กล้องเริ่มก่อนเวลาคาบกี่นาที ค่าเริ่มต้น 20
CAMERA_OPEN_BEFORE_MIN=
# 1 = log คะแนนทุกหน้าที่กล้องจับได้ (ไม่มีรูป)
MATCH_LOG=
# media server (MediaMTX: npm run media:up) ไม่ตั้ง secret = ยังไม่เปิดกล้องสด/ดูย้อนหลัง
# สร้างได้ด้วย: openssl rand -hex 32 (คนละค่ากัน)
# TOKEN = เซ็น token ให้คนดู, SERVER = API ใช้เรียก playback/control API ของ MediaMTX
MEDIA_TOKEN_SECRET=
MEDIA_SERVER_SECRET=
# ค่าเริ่มต้นเป็นเครื่องตัวเอง ดูจากเครื่องอื่นในวงเดียวกันให้ใช้ชื่อเครื่อง เช่น http://BMac.local:8889
MEDIA_RTSP_URL=
MEDIA_WEBRTC_URL=
MEDIA_PLAYBACK_URL=
MEDIA_API_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
