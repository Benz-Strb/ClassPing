# ใช้ชื่อเครื่องในวง Wi-Fi (ดูได้จาก: scutil --get LocalHostName) ห้ามใช้ IP
# เพราะ Supabase ไม่ยอม redirect กลับไปที่ URL ที่เป็น IP
EXPO_PUBLIC_API_URL=http://<ชื่อเครื่อง>.local:3001
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ใส่ไว้ใน .env.local (Expo ไม่ยอมอ่านจาก .env)
# REACT_NATIVE_PACKAGER_HOSTNAME=<ชื่อเครื่อง>.local
